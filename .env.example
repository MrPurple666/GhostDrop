# Backend handler variables (set by Terraform; shown for reference)
AWS_REGION=us-east-1
GHOSTDROP_ENVIRONMENT=local
GHOSTDROP_ALLOWED_ORIGIN=http://localhost:5173
GHOSTDROP_MAX_FILE_SIZE_BYTES=524288000
GHOSTDROP_MIN_LIFETIME_SECONDS=300
GHOSTDROP_MAX_LIFETIME_SECONDS=2592000
GHOSTDROP_UPLOAD_URL_SECONDS=900
GHOSTDROP_DOWNLOAD_URL_SECONDS=300

# Local Floci wiring (see docs/local-development.md)
#   clients reach the emulator; the presigner emits browser-reachable URLs
GHOSTDROP_AWS_ENDPOINT_URL=http://host.docker.internal:4566
GHOSTDROP_PUBLIC_S3_ENDPOINT=http://localhost.floci.io:4566

# Frontend (Vite). Empty = same origin (the make serve proxy).
VITE_API_URL=
